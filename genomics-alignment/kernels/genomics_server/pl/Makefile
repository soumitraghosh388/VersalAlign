PLATFORM := xilinx_vck5000_gen4x8_qdma_2_202220_1
TARGET   := hw
FREQ     := 300

BUILD_DIR = build.$(TARGET)
VPP_FLAGS = -t $(TARGET) --platform $(PLATFORM) --kernel_frequency $(FREQ)

all: $(BUILD_DIR)/dist_server.xo $(BUILD_DIR)/collect_server.xo

# server .cpp files are generated by gen_servers.py (parameterized by NUM_ROWS/NUM_COLS)
gen:
	python3 gen_servers.py

$(BUILD_DIR)/dist_server.xo: dist_server.cpp
	@mkdir -p $(BUILD_DIR)
	v++ $(VPP_FLAGS) -k dist_server -c -g -o $@ $<

$(BUILD_DIR)/collect_server.xo: collect_server.cpp
	@mkdir -p $(BUILD_DIR)
	v++ $(VPP_FLAGS) -k collect_server -c -g -o $@ $<

clean:
	rm -rf $(BUILD_DIR) *.log *.jou .Xil/
